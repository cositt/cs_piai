<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="cs_piai_relapse_prevention_view_form" model="ir.ui.view">
            <field name="name">cs.piai.relapse.prevention.form</field>
            <field name="model">cs.piai.relapse.prevention</field>
            <field name="arch" type="xml">
                <form string="Plan de Prevención de Recaídas">
                    <sheet>
                        <group>
                            <group col="1">
                                <field name="high_risk_situations" placeholder="Situaciones de alto riesgo identificadas..."/>
                            </group>
                            <group col="1">
                                <field name="warning_signs" placeholder="Señales de aviso tempranas..."/>
                            </group>
                        </group>
                        <group>
                            <group col="1">
                                <field name="coping_strategies" placeholder="Estrategias de afrontamiento..."/>
                            </group>
                            <group col="1">
                                <field name="social_support_plan" placeholder="Plan de apoyo social..."/>
                            </group>
                        </group>
                        <group>
                            <group col="1">
                                <field name="action_plan_relapse" placeholder="Plan de actuación ante una recaída..."/>
                            </group>
                            <group>
                                <field name="emergency_contacts"/>
                                <field name="emergency_resources"/>
                                <field name="psychoeducation_completed"/>
                            </group>
                        </group>
                        <group string="Observaciones" col="1">
                            <field name="notes" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="cs_piai_diagnosis_view_form" model="ir.ui.view">
            <field name="name">cs.piai.diagnosis.form</field>
            <field name="model">cs.piai.diagnosis</field>
            <field name="arch" type="xml">
                <form string="Diagnóstico / Formulación del Caso">
                    <sheet>
                        <group>
                            <group>
                                <field name="date_diagnosis"/>
                                <field name="professional_id"/>
                                <field name="prognosis"/>
                                <field name="dual_pathology"/>
                            </group>
                            <group>
                                <field name="cie10_code"/>
                                <field name="dsm5_code"/>
                            </group>
                        </group>
                        <group>
                            <group col="1">
                                <field name="main_diagnosis" placeholder="Diagnóstico principal..."/>
                            </group>
                            <group col="1">
                                <field name="differential_diagnosis" placeholder="Diagnóstico diferencial..."/>
                            </group>
                        </group>
                        <group col="1">
                            <field name="case_formulation" placeholder="Formulación del caso..."/>
                        </group>
                        <group col="1">
                            <field name="working_hypothesis" placeholder="Hipótesis de trabajo..."/>
                        </group>
                        <group col="1" invisible="not dual_pathology">
                            <field name="dual_pathology_notes" placeholder="Notas patología dual..."/>
                        </group>
                        <group col="1">
                            <field name="notes" placeholder="Observaciones adicionales..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="cs_piai_family_plan_view_form" model="ir.ui.view">
            <field name="name">cs.piai.family.plan.form</field>
            <field name="model">cs.piai.family.plan</field>
            <field name="arch" type="xml">
                <form string="Plan Familiar y Social">
                    <sheet>
                        <group string="Plan familiar">
                            <group>
                                <field name="family_involvement_level"/>
                                <field name="family_sessions_frequency"/>
                                <field name="next_family_session"/>
                                <field name="responsible_worker_id"/>
                            </group>
                            <group col="1">
                                <field name="family_goals" placeholder="Objetivos con la familia..."/>
                                <field name="family_education" placeholder="Psicoeducación familiar..."/>
                                <field name="communication_plan" placeholder="Plan de comunicación..."/>
                            </group>
                        </group>
                        <group string="Restricciones operativas (visibles a monitoras)">
                            <group col="1">
                                <field name="restrictions_calls" placeholder="Ej: Sin llamadas hasta las 10h..."/>
                                <field name="restrictions_visits" placeholder="Ej: Visitas solo sábados..."/>
                                <field name="restrictions_outings" placeholder="Ej: Salidas acompañado únicamente..."/>
                            </group>
                            <group col="1">
                                <field name="restrictions_objects" placeholder="Ej: Sin móvil propio..."/>
                                <field name="restrictions_medication" placeholder="Ej: Medicación supervisada por enfermería..."/>
                            </group>
                        </group>
                        <group string="Plan social">
                            <group col="1">
                                <field name="social_integration_goals" placeholder="Objetivos de integración social..."/>
                                <field name="community_resources" placeholder="Recursos comunitarios identificados..."/>
                            </group>
                            <group col="1">
                                <field name="social_network_plan" placeholder="Plan de red de apoyo..."/>
                                <field name="employment_training_plan" placeholder="Plan de formación / empleo..."/>
                            </group>
                        </group>
                        <group string="Observaciones" col="1">
                            <field name="notes" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
