<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Todos los usuarios pueden leer todos los PIAIs (visibilidad transversal entre profesionales).
             La restricción de escritura se gestiona mediante el CSV de permisos por grupo. -->
        <record id="rule_piai_all_read" model="ir.rule">
            <field name="name">PIAI - Lectura para todos</field>
            <field name="model_id" ref="model_cs_piai"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
